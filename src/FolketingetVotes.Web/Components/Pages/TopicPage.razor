@page "/emner/{Id:int}"
@inject ITopicQueries Topics
@inject NavigationManager Navigation

@if (topic is null)
{
    <PageTitle>Emne</PageTitle>
    <p>Indlæser…</p>
}
else
{
    <PageTitle>@topic.Name – afstemninger</PageTitle>
    <PageMeta Title="@($"Emne: {topic.Name}")" Description="@($"{topic.CaseCount} sager og {topic.Votes.TotalCount} afstemninger i Folketinget om {topic.Name}.")" />
    <p class="muted small"><a href="/emner">Emner</a> › @Labels.KeywordType(topic.TypeId)</p>
    <h1>@topic.Name</h1>
    <p class="lead">@Labels.Number(topic.CaseCount) sager, @Labels.Number(topic.Votes.TotalCount) afstemninger i salen@(topic.PeriodId is null ? "" : " i det valgte folketingsår").</p>

    @if (topic.PerSession.Count > 1)
    {
        <h2>Over tid</h2>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Folketingsår</th><th class="num">Afstemninger</th><th class="num">Endelige vedtagelser</th><th class="num">Heraf vedtaget</th></tr></thead>
                <tbody>
                    <tr style="@(topic.PeriodId is null ? "font-weight:600" : "")"><td><a href="/emner/@Id">Alle år</a></td><td class="num">@Labels.Number(topic.PerSession.Sum(r => r.Votes))</td><td class="num">@Labels.Number(topic.PerSession.Sum(r => r.FinalVotes))</td><td class="num">@Labels.Number(topic.PerSession.Sum(r => r.Passed))</td></tr>
                    @foreach (var r in topic.PerSession)
                    {
                        <tr style="@(topic.PeriodId == r.PeriodId ? "font-weight:600" : "")"><td><a href="/emner/@Id?period=@r.PeriodId">@r.PeriodTitle</a></td><td class="num">@r.Votes</td><td class="num">@r.FinalVotes</td><td class="num">@r.Passed</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small muted">Vælg et år for at se partiernes flertal og afstemningerne i netop det år.</p>
    }

    @if (topic.Parties.Count > 0)
    {
        <h2>Partiernes flertal ved endelige vedtagelser</h2>
        <p class="small muted">For hver endelig vedtagelse om emnet: stemte flertallet af partiets tilstedeværende medlemmer for, imod eller hverken/eller. Tæller afstemninger, ikke medlemmer.</p>
        <BallotLegend IncludeAbsent="false" />
        <div class="bar-rows">
            @foreach (var p in topic.Parties)
            {
                <div class="label"><PartyChip ShortName="@p.PartyShortName" Name="@p.PartyName" /></div>
                <BallotStack ForCount="p.VotesFor" AgainstCount="p.VotesAgainst" AbstainCount="p.VotesAbstain" IncludeAbsent="false" />
                <div class="value">@p.VotesFor / @p.VotesAgainst / @p.VotesAbstain</div>
            }
        </div>
        <p class="small muted">Tal pr. parti: for / imod / hverken.</p>
    }

    <h2>Afstemninger</h2>
    <VoteList Votes="topic.Votes.Items" />
    <Pager Page="topic.Votes.Page" TotalPages="topic.Votes.TotalPages" Href="Href" />
}

@code {
    private const int PageSize = 25;

    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = "period")] public int? Period { get; set; }

    private TopicDetail? topic;

    protected override async Task OnInitializedAsync()
    {
        topic = await Topics.GetAsync(Id, Period, Math.Max(1, Page ?? 1), PageSize);
        if (topic is null)
        {
            Navigation.NotFound();
        }
    }

    private string Href(int page) => QueryString.Build($"/emner/{Id}", ("period", Period?.ToString()), ("page", page.ToString()));
}
